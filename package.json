{
  "name": "be-formidable",
  "version": "0.0.18",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "decorate",
    "behavior",
    "directive",
    "forms",
    "validation"
  ],
  "description": "Add additional validations on form element beyond those that can be specified on an individual field level.",
  "main": "be-formidable.js",
  "module": "be-formidable.js",
  "exports": {
    ".": "./be-formidable.js",
    "./be-formidable.js": "./be-formidable.js"
  },
  "files": [
    "*.*"
  ],
  "types": "types.d.ts",
  "scripts": {
    "test": "playwright test",
    "serve": "python3 ./node_modules/ssi-server/ssi_server.py",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-enhanced": "0.0.151",
    "be-hive": "0.0.231",
    "trans-render": "0.0.857",
    "xtal-element": "0.0.619"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "ssi-server": "0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-formidable.git"
  },
  "author": "Bruce Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-formidable/issues"
  },
  "homepage": "https://github.com/bahrus/be-formidable#readme"
}
